# 复制为 .env 后按需修改

# 对外访问端口（默认 http://localhost:8080）
EFFLUX_HTTP_PORT=8080

# 数据库密码（生产环境请务必改成随机长口令）
POSTGRES_PASSWORD=efflux_local_password

# 日志级别：error | warn | info | debug
RUST_LOG=info

# ---------------------------------------------------------------------------
# 家庭访问口令
#
# 这里填的值只用于「首次启动初始化」：会被写进数据库（存 PBKDF2 哈希），
# 之后可以在站点的「设置」页里随时修改 —— 不用改这个文件，也不用重启。
#
# 留空 = 不做鉴权，任何人知道网址就能看和改 —— 只适合本机开发。
# 放到公网前必须设置，至少 6 位，建议一句只有家人知道的长句子。
#
#   EFFLUX_ACCESS_CODE=外婆家的黄河鲤鱼跳过了篱笆
#
# 登录状态保持天数（默认 30）
# EFFLUX_SESSION_DAYS=30
#
# 会话 Cookie 是否只在 HTTPS 下发送（公网部署请设为 true）
# EFFLUX_COOKIE_SECURE=true
#
# 后端自带的限流（登录 12 次/分钟、其余 API 30 次/秒，按客户端地址算）。
# 默认开着；哪天觉得太紧（比如一家人共用一个出口 IP）再关：
#   EFFLUX_RATE_LIMIT=off
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 本地部署（不用 Docker）的几项
#
# deploy/local.sh 会自己把 EFFLUX_STATIC_DIR 指到 frontend/dist，
# 手工起进程时才需要写：
#   EFFLUX_STATIC_DIR=/绝对路径/efflux/frontend/dist
#
# 数据目录（后端默认 ./data，本地部署脚本用的是仓库里的 .data）
#   EFFLUX_DATA_DIR=./.data
#
# 图片自动打标签与「找相似」，需要模型文件（见 README 的「自动识别」）
#   EFFLUX_TAGGER=1
#   EFFLUX_MODEL_DIR=./backend/models
# ---------------------------------------------------------------------------
EFFLUX_ACCESS_CODE=
